 subgraph cluster_system {label="Barangay Vehicle Management System"; fontsize=18; color="#93c5fd"; style="rounded"; margin=24;
 register [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Register first barangay Admin\nwithout a staff code"];
