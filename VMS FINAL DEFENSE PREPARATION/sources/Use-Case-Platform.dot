digraph UseCase {graph [bgcolor="white", fontname="Arial", fontsize=24, fontcolor="#0f172a", pad=0.45, nodesep=0.4, ranksep=1.0, labelloc=t, labeljust=l];
node [fontname="Arial", fontsize=13, color="#94a3b8", fontcolor="#0f172a", penwidth=1.1];
edge [fontname="Arial", fontsize=10, color="#64748b", fontcolor="#475569", penwidth=1.1]; graph [rankdir=LR, splines=polyline, nodesep=0.32, ranksep=1.1, label="02B  USE-CASE DIAGRAM | Onboarding and platform support\nMerged SMTP activation and Support Center | revision 352fd0e"];
 applicant [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#94a3b8", label="<<actor>>\nApplicant / visitor"];
sa [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#94a3b8", label="<<actor>>\nSuper Admin"];
