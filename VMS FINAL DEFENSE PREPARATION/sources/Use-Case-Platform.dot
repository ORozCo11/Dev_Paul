activate [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Activate with credentials\nand emailed code"];
staff [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Register later staff\nwith barangay code"];
manage [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Manage platform users,\nbarangays and codes"];
concern [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Submit public concern"];
resolve [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Review / resolve concerns;\nview Concern History"];
audit [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Review platform audit\nand boundary references"];
 }
