"notifications" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>notifications</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">notification_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">ticket_id ?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">schedule_id ?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">read_at ?</TD></TR></TABLE>>];
 "provinces" -> "cities" [dir=both, arrowtail=teetee, arrowhead="crowodot", style=solid, label="province_id"];
