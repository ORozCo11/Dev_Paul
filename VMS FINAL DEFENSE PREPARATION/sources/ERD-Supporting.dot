digraph Support {graph [bgcolor="white", fontname="Arial", fontsize=24, fontcolor="#0f172a", pad=0.45, nodesep=0.4, ranksep=1.0, labelloc=t, labeljust=l];
node [fontname="Arial", fontsize=13, color="#94a3b8", fontcolor="#0f172a", penwidth=1.1];
edge [fontname="Arial", fontsize=10, color="#64748b", fontcolor="#475569", penwidth=1.1]; graph [rankdir=LR, splines=polyline, label="01B  SUPPORTING ENTITIES | Geography, evidence and platform support
Selected attributes/relations | Solid = migrated FK; dashed = logical code relationship | ? = nullable"];
 "provinces" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>provinces</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">code ?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">name</TD></TR></TABLE>>];
"cities" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>cities</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">province_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">name</TD></TR></TABLE>>];
"barangays" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>barangays</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">city_id ?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">name</TD></TR></TABLE>>];
"registration_settings" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>registration_settings</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">barangay_id ?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">staff_code</TD></TR></TABLE>>];
"users" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>users</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">barangay_id ?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">email</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">roles ?</TD></TR></TABLE>>];
"vehicles" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>vehicles</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">vehicle_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">barangay_id ?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">category_id</TD></TR></TABLE>>];
"vehicle_categories" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>vehicle_categories</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">category_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">category_name</TD></TR></TABLE>>];
"vehicle_type_fields" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>vehicle_type_fields</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">field_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">category_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">key</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">field_type</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">is_active</TD></TR></TABLE>>];
"vehicle_documents" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>vehicle_documents</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">document_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">vehicle_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">added_by</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">file_url</TD></TR></TABLE>>];
"vehicle_histories" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>vehicle_histories</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">history_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">vehicle_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">updated_by ?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">related_table ?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">related_record_id ?</TD></TR></TABLE>>];
"vehicle_locations" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>vehicle_locations</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">location_record_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">vehicle_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">updated_by</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">current_location</TD></TR></TABLE>>];
"vehicle_hubs" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>vehicle_hubs</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">hub_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">barangay_id ?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">created_by ?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">lat</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">lng</TD></TR></TABLE>>];
"issue_report_attachments" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>issue_report_attachments</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">attachment_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">issue_report_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">uploaded_by</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">file_url</TD></TR></TABLE>>];
"vehicle_issue_reports" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>vehicle_issue_reports</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">issue_report_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">vehicle_id</TD></TR></TABLE>>];
"ticket_sub_issues" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>ticket_sub_issues</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">sub_issue_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">ticket_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">source_vehicle_id ?</TD></TR></TABLE>>];
"ticket_sub_issue_donor_parts" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>ticket_sub_issue_donor_parts</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">part_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">sub_issue_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">part_name</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">quantity</TD></TR></TABLE>>];
"cannibalization_records" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>cannibalization_records</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">cannibalization_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">source_vehicle_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">destination_vehicle_id ?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">recorded_by</TD></TR></TABLE>>];
"cannibalization_parts" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>cannibalization_parts</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">part_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">cannibalization_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">part_name</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">quantity</TD></TR></TABLE>>];
"concern_reports" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>concern_reports</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">concern_type</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">reporter_name ?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">resolved_by ?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">deleted_at ?</TD></TR></TABLE>>];
"activity_logs" [shape=plain, label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e8f0fe"><B>activity_logs</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">log_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">user_id ?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">FK</FONT></TD><TD ALIGN="LEFT">barangay_id ?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">action</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">impersonator_user_id ?</TD></TR></TABLE>>];
