digraph UseCase {graph [bgcolor="white", fontname="Arial", fontsize=24, fontcolor="#0f172a", pad=0.45, nodesep=0.4, ranksep=1.0, labelloc=t, labeljust=l];
node [fontname="Arial", fontsize=13, color="#94a3b8", fontcolor="#0f172a", penwidth=1.1];
edge [fontname="Arial", fontsize=10, color="#64748b", fontcolor="#475569", penwidth=1.1]; graph [rankdir=LR, splines=polyline, nodesep=0.32, ranksep=1.1, label="02  USE-CASE DIAGRAM | Fleet readiness and maintenance\nAssociations show role participation, not workflow order | revision 352fd0e"];
 admin [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#94a3b8", label="<<actor>>\nAdmin"];
custodian [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#94a3b8", label="<<actor>>\nCustodian"];
mechanic [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#94a3b8", label="<<actor>>\nMaintenance Personnel"];
clock [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#94a3b8", label="<<actor>>\nLaravel scheduler"];
 subgraph cluster_system {label="Barangay Vehicle Management System"; fontsize=18; color="#93c5fd"; style="rounded"; margin=24;
 vehicle [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Register vehicle"];
history [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="View permitted fleet and\ncompleted repair history"];
fleet [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Manage fleet, hubs,\nusers and reports"];
issue [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Report vehicle issue"];
propose [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Propose / resubmit ticket"];
approve [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Review proposal and\nassign repair personnel"];
repair [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Record assigned repairs\nand submit completed work"];
external [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Record external-shop\nsending, return and rework"];
verify [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Independently verify repair\nand close or return for rework"];
readiness [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Record condition / attest\nfresh operational readiness"];
book [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Book / edit own schedule"];
review [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Approve / decline /\nreassign schedule"];
complete [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Complete assigned\nstandalone schedule"];
record [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Enter / confirm standalone\nmaintenance record"];
verifyRecord [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Independently verify\nstandalone maintenance"];
convert [shape=ellipse, style=filled, fillcolor="#eff6ff", color="#93c5fd", margin="0.18,0.12", label="Convert due approved\nschedule to ticket proposal"];
 }
 admin -> vehicle [dir=none];
custodian -> vehicle [dir=none];
admin -> history [dir=none];
custodian -> history [dir=none];
mechanic -> history [dir=none];
admin -> fleet [dir=none];
custodian -> issue [dir=none];
mechanic -> issue [dir=none];
custodian -> propose [dir=none];
admin -> approve [dir=none];
mechanic -> repair [dir=none];
admin -> external [dir=none];
custodian -> verify [dir=none];
custodian -> readiness [dir=none];
custodian -> book [dir=none];
admin -> review [dir=none];
mechanic -> complete [dir=none];
admin -> record [dir=none];
custodian -> verifyRecord [dir=none];
clock -> convert [dir=none];
 }