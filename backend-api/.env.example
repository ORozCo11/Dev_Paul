APP_NAME=Laravel

# NOTE: APP_ENV=local, APP_DEBUG=true, and LOG_LEVEL=debug below are for
# LOCAL DEVELOPMENT ONLY. Before deploying to any real/production
# environment, change them to:
#   APP_ENV=production
#   APP_DEBUG=false
#   LOG_LEVEL=error
# Leaving APP_DEBUG=true in production leaks stack traces (including
# secrets from this file) to anyone who triggers an error.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# LOCAL DEVELOPMENT ONLY — use LOG_LEVEL=error (or similar) in production.
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barangay_vms_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Minutes until an issued Sanctum API token (login or impersonation) expires.
# See config/sanctum.php. 10080 = 7 days.
SANCTUM_TOKEN_EXPIRATION=10080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log only writes emails to storage/logs/laravel.log. To really send
# them through Gmail, use an app password (Google Account > Security > 2-Step
# Verification > App passwords) and set:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_SCHEME=null
#   MAIL_USERNAME=your.address@gmail.com
#   MAIL_PASSWORD=your-16-character-app-password
#   MAIL_FROM_ADDRESS=your.address@gmail.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_INLINE_LOGO=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Uploads are stored on the server's private local disk (storage/app/private).
# No cloud storage is used.

VITE_APP_NAME="${APP_NAME}"
